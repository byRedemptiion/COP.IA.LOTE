# Copier ce fichier en ".env" (même dossier) puis coller la clé après le signe =.
# Ne jamais committer le fichier .env : il est exclu par .gitignore.

# Clé Google Gemini (gratuite) : https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=

# Facultatif : changer de fournisseur sans toucher à la config (gemini | ollama | fake)
# ALICE_AI_PROVIDER=gemini

# Facultatif : logs détaillés (DEBUG | INFO)
# ALICE_LOG_LEVEL=INFO

# Seulement si le dépôt GitHub d'ALICIA devient privé : jeton « fine-grained » en lecture
# seule (Contents: Read-only) sur ce dépôt, pour le bouton MAJ. Jamais partagé ni affiché.
ALICIA_GITHUB_TOKEN=
